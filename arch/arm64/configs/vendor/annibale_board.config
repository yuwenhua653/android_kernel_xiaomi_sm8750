# SPDX-License-Identifier: GPL-2.0-only
# Apply after gki_defconfig and vendor/sun_perf.config.
# Only independently sourced annibale board drivers are enabled here.
# CONFIG_IR_SPI is not set
CONFIG_IR_SPI_XIAOMI=m
CONFIG_MI_T1_CHIP=m
CONFIG_INPUT_PM8941_PWRKEY=m
CONFIG_INPUT_PM8941_PWRKEY_XIAOMI=y
# AW21024 source is available, but no matching annibale DT node is published.
# CONFIG_LEDS_AW21024 is not set
# Fingerprint remains an explicitly selected experimental candidate.
# Charging still requires the missing Xiaomi MCA integration.

# Xiaomi HAL controls on the Annibale PMIH010x haptics node only.
CONFIG_INPUT_QCOM_HV_HAPTICS=m
CONFIG_INPUT_QCOM_HV_HAPTICS_XIAOMI=y

# Real bootloader hwid parameters must be supplied by the module loader.
CONFIG_MI_HARDWARE_ID=m
CONFIG_MI_WIFI_GPIO=m
# CONFIG_FINGERPRINT_MI_FP is not set
