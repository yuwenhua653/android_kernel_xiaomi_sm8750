CONFIG_LZ4ASM=m
CONFIG_MI_SOFTWARE_INFO=m
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m
CONFIG_MTD_OF_PARTS=m
CONFIG_TLS=m
CONFIG_STAGING=y
CONFIG_MIEV=m
CONFIG_MI_RMAP_EFFICIENCY=m
CONFIG_KSHRINK_SLABD=m
CONFIG_NTSYNC=m
